{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immo-web-suite",
  "main": "worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 0 * * 1",
      "0 2 * * 1",
      "0 4 * * *"
    ]
  }
}
