{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immo-web-suite",
  "main": "worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "IMMO_SYNC_DB",
      "database_name": "immo-web-suite-sync",
      "database_id": "112c46c3-0718-4e3f-8a51-d11529b1ba4f",
      "migrations_dir": "d1/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 0 * * 1",
      "0 2 * * 1",
      "0 4 * * *"
    ]
  }
}
